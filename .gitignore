# Rust build output. ~340 MB each.
# target-alt is used to build while a daemon is holding target/debug/dcs-signal.exe.
/target/
/target-alt/

# Generated signal catalogue - NOT committed on purpose.
#
# The daemon and the editor build this from the DCS-BIOS installed on the local
# machine, on startup, whenever the installed version differs from the one it
# was built from. It must not be shared, because:
#   * DCS-BIOS allocates addresses sequentially as controls are defined, so a
#     catalogue built against a different release reads the wrong addresses,
#     silently and with no runtime error
#   * index.json records the absolute path it was generated from
#   * it is ~11 MB and regenerates in about a second
#
# Force a rebuild with:  cargo run --bin dcs-signal -- catalogue --rebuild
/data/catalogue/
# A build in progress, the one it replaces, and the lock between them.
/data/catalogue.building/
/data/catalogue.old/
/data/catalogue.lock

# Shipped profiles live in data/defaults and ARE tracked. They are the product:
# a baseline every user starts from, and the reference for the format.
#
# data/profiles is the active folder, the one the daemon reads and the editor
# writes. It is seeded from data/defaults on startup for any name it does not
# already have, so it regenerates itself and must not be committed: tracking it
# would mean every edit made while testing showed up as a diff against the
# thing being shipped.
/data/profiles/

# One developer's choice of layout, never something that ships. `.env.example`
# is the tracked copy. env=dev points the editor and the daemon at
# data/defaults, so development never touches the profiles you fly.
/.env

# Node output for the editor.
/editor/node_modules/
/editor/dist/

# Captures and logs from reverse-engineering sessions. Some contain device
# serial numbers.
*.pcap
*.pcapng
*.log
*.bak
/captures/

# Local tool state
.claude/settings.local.json

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
