# Rust build output. ~340 MB each.
# target-alt is used to build while a daemon is holding target/debug/wctrl.exe.
/target/
/target-alt/

# Generated signal catalogue - NOT committed on purpose.
#
# tools/build_catalogue.py builds this from the DCS-BIOS installed on the local
# machine. It must not be shared, because:
#   * DCS-BIOS allocates addresses sequentially as controls are defined, so a
#     catalogue built against a different release reads the wrong addresses,
#     silently and with no runtime error
#   * index.json records the absolute path it was generated from
#   * it is ~11 MB and regenerates in about two seconds
#
# Rebuild with:  python tools/build_catalogue.py
/data/catalogue/

# Profiles in data/profiles ARE tracked. They are the worked examples that make
# the tool usable out of the box, and they are the reference for the format.
# A user's own profiles will live in their app data directory, not here.

# Captures and logs from reverse-engineering sessions. Some contain device
# serial numbers.
*.pcap
*.pcapng
*.log
/captures/

# Local tool state
.claude/settings.local.json

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
